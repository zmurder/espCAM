# This file was generated using idf.py save-defconfig. It can be edited manually.
#
# Espressif IoT Development Framework (ESP-IDF) Project Minimal Configuration
#
# CONFIG_LWIP_IP_FORWARD=y
# CONFIG_LWIP_IPV4_NAPT=y
#

CONFIG_CAMERA_MODEL_ESP32S3_EYE=y

# 16MB Flash
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 自定义分区表 (factory=4MB, nvs=24K, phy=16K)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 启用 PSRAM（如果硬件支持）
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TYPE_AUTO=y

# 将更多代码和数据放在 PSRAM 中，减少 IRAM 使用
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_USE_MALLOC=y

# 优化 IRAM 使用
CONFIG_ESP32S3_INSTRUCTION_CACHE_WRAP=y

# WiFi 优化
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32

# 关闭 IRAM 优化，释放 IRAM 空间
# 关闭后这些功能仍正常工作，只是性能略有下降
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM=n
CONFIG_GDMA_ISR_HANDLER_IN_IRAM=n
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
CONFIG_SPI_SLAVE_ISR_IN_IRAM=n

# Watchdog超时增加到40秒（yolo11模型推理需要更长时间）
CONFIG_ESP_TASK_WDT_TIMEOUT_S=40

# CPU 240MHz（最高频，加速模型推理；SDK 默认仅 160MHz）
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 日志时间戳使用系统时间：SNTP 对时后（time_sync.c）所有日志带真实日期时间
CONFIG_LOG_TIMESTAMP_SOURCE_SYSTEM=y

# SNTP 服务器数量：time_sync.c 配置了主备两台（ntp.aliyun.com + pool.ntp.org）
CONFIG_LWIP_SNTP_MAX_SERVERS=2